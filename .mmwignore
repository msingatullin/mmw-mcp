# MMW Secret & Sensitive Data Boundary (.mmwignore)
# Example convention for your own agent instructions: paths whose contents agents should not
# store in MMW memory. NOTE: this file is NOT read or enforced by the MMW server or by mmw-agent.
# Server-side redaction of secrets happens independently of this file.

# Environment & Secrets
.env
.env.*
*.env
*.pem
*.key
*.cert
*.crt
id_rsa
id_ed25519
*.pfx
*.p12

# Cloud & Infrastructure Credentials
.aws/
.gcp/
.azure/
credentials
secrets.json
service-account*.json

# API Keys & Auth Tokens
*token*
*secret*
*password*
*.htpasswd
auth_tokens.json

# Local IDE & OS Storage
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log
*.sqlite
*.db

# Build Artifacts & Dependencies
node_modules/
venv/
.venv/
__pycache__/
dist/
build/
*.vsix
*.mcpb
