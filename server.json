{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.msingatullin/mmw",
  "title": "MMW Managed Memory Workspace",
  "description": "Shared memory across AI agents, with source-aware facts and visible conflicts.",
  "version": "1.2.1",
  "websiteUrl": "https://mmwhub.tech",
  "repository": {
    "url": "https://github.com/msingatullin/mmw-mcp",
    "source": "github"
  },
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.mmwhub.tech/mcp",
      "headers": [
        {
          "name": "Authorization",
          "description": "Bearer MMW API Token",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ],
  "icons": [
    {
      "src": "https://mmwhub.tech/icon.png",
      "mimeType": "image/png",
      "sizes": [
        "800x800",
        "any"
      ]
    },
    {
      "src": "https://mmwhub.tech/favicon.svg",
      "mimeType": "image/svg+xml",
      "sizes": [
        "any"
      ]
    }
  ]
}
